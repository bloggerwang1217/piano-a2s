# Machine-local paths, sourced by the pipeline and slurm scripts.
# Copy to env.sh and fill every value in; env.sh is not tracked.

PROJECT_ROOT=!PLACEHOLDER        # this checkout
CONDA_SH=!PLACEHOLDER            # <conda install>/etc/profile.d/conda.sh
CONDA_ENV=!PLACEHOLDER           # environment for the transcription pipeline
CONDA_ENV_BEATTHIS=!PLACEHOLDER  # environment that has Beat This! installed
ASAP_DIR=!PLACEHOLDER            # asap-dataset checkout

# Fail at source time rather than letting a slurm array run against a
# half-configured path.
for _var in PROJECT_ROOT CONDA_SH CONDA_ENV CONDA_ENV_BEATTHIS ASAP_DIR; do
    case "${!_var}" in
        ""|"!PLACEHOLDER")
            echo "env.sh: $_var is unset — copy env.sh.example and fill it in" >&2
            exit 1
            ;;
    esac
done
unset _var

export PROJECT_ROOT CONDA_SH CONDA_ENV CONDA_ENV_BEATTHIS ASAP_DIR
